<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>随机 Meme 转盘</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: linear-gradient(145deg, #1e1e2f 0%, #2a2a40 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            padding: 16px;
            color: #fff;
        }

        .container {
            max-width: 700px;
            width: 100%;
            background: rgba(255, 255, 255, 0.06);
            backdrop-filter: blur(12px);
            border-radius: 48px;
            padding: 32px 24px 40px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8), inset 0 1px 2px rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.1);
            text-align: center;
            transition: all 0.2s;
        }

        h1 {
            font-size: 2rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            background: linear-gradient(135deg, #f9d976, #f39f86);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            margin-bottom: 8px;
        }

        .subtitle {
            font-size: 0.95rem;
            color: #aaa;
            margin-bottom: 28px;
        }

        .meme-stage {
            background: #0f0f1a;
            border-radius: 32px;
            padding: 20px;
            margin-bottom: 28px;
            min-height: 320px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            border: 1px solid #2f2f44;
            box-shadow: inset 0 8px 20px rgba(0, 0, 0, 0.6);
            transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s;
            position: relative;
            overflow: hidden;
        }

        .meme-stage.spin {
            animation: wobble 0.6s ease-in-out;
        }

        @keyframes wobble {
            0% { transform: scale(0.96) rotate(-0.5deg); }
            25% { transform: scale(1.02) rotate(1deg); }
            50% { transform: scale(0.99) rotate(-0.8deg); }
            75% { transform: scale(1.01) rotate(0.5deg); }
            100% { transform: scale(1) rotate(0); }
        }

        .meme-img {
            max-width: 100%;
            max-height: 360px;
            border-radius: 16px;
            display: block;
            object-fit: contain;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.7);
            transition: opacity 0.3s ease;
        }

        .placeholder {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            color: #555;
            font-size: 1.1rem;
        }

        .placeholder span {
            font-size: 3.5rem;
            filter: grayscale(1) brightness(0.6);
        }

        .meme-title {
            margin-top: 16px;
            font-size: 0.9rem;
            color: #b0b0d0;
            word-break: break-word;
            max-width: 100%;
            padding: 0 8px;
            line-height: 1.4;
        }

        .draw-btn {
            background: linear-gradient(135deg, #f9d976 0%, #f39f86 100%);
            border: none;
            border-radius: 60px;
            padding: 18px 48px;
            font-size: 1.3rem;
            font-weight: 700;
            color: #1e1e2f;
            cursor: pointer;
            box-shadow: 0 10px 20px -5px rgba(243, 159, 134, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.2) inset;
            transition: transform 0.1s ease, box-shadow 0.2s ease;
            letter-spacing: 0.5px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            width: 100%;
            max-width: 300px;
        }

        .draw-btn:hover {
            box-shadow: 0 15px 30px -5px rgba(243, 159, 134, 0.7);
            transform: translateY(-2px);
        }

        .draw-btn:active {
            transform: scale(0.97);
            box-shadow: 0 5px 15px -3px rgba(243, 159, 134, 0.5);
        }

